{
  "version": 2,
  "images": {
    "sizes": [640, 828, 1080, 1200, 1920],
    "formats": ["image/webp"],
    "minimumCacheTTL": 3600
  },
  "crons": [
    {
      "path": "/api/telegram/dispatch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/telegram/coach-digest",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/parent/telegram-link",
      "destination": "/api/mono-parent-status.ts?mode=telegram-link"
    },
    {
      "source": "/api/parent/social-links",
      "destination": "/api/mono-parent-status.ts?mode=parent-social-links"
    },
    {
      "source": "/api/telegram/parent-webhook",
      "destination": "/api/mono-parent-config.ts?mode=telegram-parent-webhook"
    },
    {
      "source": "/api/telegram/dispatch",
      "destination": "/api/mono-parent-status.ts?mode=telegram-dispatch"
    },
    {
      "source": "/api/telegram/webhook-status",
      "destination": "/api/mono-parent-config.ts?mode=telegram-webhook-status"
    },
    {
      "source": "/api/telegram/setup-webhook",
      "destination": "/api/mono-parent-config.ts?mode=telegram-webhook-status"
    },
    {
      "source": "/api/telegram/bot-info",
      "destination": "/api/mono-parent-config.ts?mode=telegram-bot-info"
    },
    {
      "source": "/api/messages/:participantId",
      "destination": "/api/mono-parent-config.ts?mode=message-list&participantId=:participantId"
    },
    {
      "source": "/api/messages",
      "destination": "/api/mono-parent-config.ts?mode=messages"
    },
    {
      "source": "/api/admin/notify/mass",
      "destination": "/api/mono-parent-config.ts?mode=admin-notify-mass"
    },
    {
      "source": "/api/admin/notify",
      "destination": "/api/mono-parent-config.ts?mode=admin-notify"
    },
    {
      "source": "/api/leads-public",
      "destination": "/api/leads-public.ts"
    },
    {
      "source": "/api/meta-lead-webhook",
      "destination": "/api/meta-lead-webhook.ts"
    },
    {
      "source": "/api/parent/payments/monobank-config",
      "destination": "/api/mono-parent-config.ts"
    },
    {
      "source": "/api/parent/payments/monobank-invoice",
      "destination": "/api/mono-parent-invoice.ts"
    },
    {
      "source": "/api/parent/payments/monobank-status",
      "destination": "/api/mono-parent-status.ts"
    },
    {
      "source": "/api/monobank/webhook",
      "destination": "/api/monobank-webhook.ts"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/shin-gi",
      "destination": "/shin-gi.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
